# Copy to .env for local overrides. Never commit .env.
# All API settings are read with the COMPASSIO_ prefix (apps/api/src/compassio_api/core/config.py).

# development | test | production
COMPASSIO_ENVIRONMENT=development
# debug | info | warning | error
COMPASSIO_LOG_LEVEL=info
# Comma-separated explicit origins. Wildcard "*" is rejected by design.
COMPASSIO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: absolute path to the data root (defaults to ./data).
# COMPASSIO_DATA_DIR=D:\path\to\compassio\data

# Database (SQLAlchemy URL). Default: local SQLite file, git-ignored. PostgreSQL is supported by the
# schema but its driver is not installed yet (docs/architecture/database_design.md).
# COMPASSIO_DATABASE_URL=sqlite:///data/db/compassio_dev.sqlite

# Source-rights access mode: public (default, fails closed: no uncleared source data is served)
# or local_development (inspect registered records on THIS machine only). Ignored when
# COMPASSIO_ENVIRONMENT=production, which always behaves as public.
# COMPASSIO_SOURCE_DATA_ACCESS=local_development

# ML v2 CLI variables are process environment variables (export them in your shell).
# These are NOT aliases of COMPASSIO_DATA_DIR, and never redirect v1 writers.
# In a combined checkout: DATA_ROOT=<this-checkout>/data; V1_PROJECT_ROOT=<this-checkout>.
# COMPASSIO_DATA_ROOT=D:\path\to\compassio\data
# COMPASSIO_V1_PROJECT_ROOT=D:\path\to\compassio
# Owned generated datasets/reports/new sealed candidates, default ./data/ml_v2:
# COMPASSIO_V2_OUTPUT_ROOT=D:\path\to\compassio\data\ml_v2
# Optional read-only reuse of another worktree's existing external_raw directory:
# COMPASSIO_V2_EXTERNAL_INPUT_ROOT=D:\path\to\ml-worktree\data\ml_v2\external_raw
# Unset EXTERNAL_INPUT_ROOT before acquisition into the owned output root.

# Task 007 model screening (local only). Screening is served only when the effective source access
# is local_development (never in production). ML v2 is a DEVELOPMENT CANDIDATE and becomes the
# default engine only in the authorized local demo (also requires COMPASSIO_ENVIRONMENT=development).
# COMPASSIO_ML_V2_LOCAL_DEMO=true
# Pins for both models: configs/inference_models.yaml. Reviews/saved screenings use a SEPARATE store:
# COMPASSIO_REVIEW_DATABASE_URL=sqlite:///data/db/compassio_reviews.sqlite
# Saving screenings / recording reviews is disabled unless a local token is set (send it as the
# X-Compassio-Review-Token header). Never commit a real token.
# COMPASSIO_REVIEW_API_TOKEN=

# Task 009 hackathon event mode (docs/hackathon/data_permission_scope.md). Serves only the sources
# of the named entry in configs/event_data_authorizations.yaml, to loopback clients only, and is
# never active in production. It is a user-reported organizer authorization, NOT a licence clearance.
# COMPASSIO_SOURCE_DATA_ACCESS=hackathon_event
# COMPASSIO_EVENT_AUTHORIZATION=battleverse_2026
# COMPASSIO_EVENT_AUTHORIZATIONS_PATH=configs/event_data_authorizations.yaml

# Task 009 hardening. Request bodies above this size get 413 (default 262144 bytes).
# COMPASSIO_MAX_REQUEST_BODY_BYTES=262144
# Per-client screening requests per minute, in-process (single worker). 0 disables. Default 60.
# COMPASSIO_SCREENING_RATE_LIMIT_PER_MINUTE=60
# Load and hash-verify the authorized models at startup (avoids the ~4-5 s first ML v1 request).
# COMPASSIO_PRELOAD_MODELS=true
# Task 012 optional local challenge adapter / availability shield (one API worker).
# Normal screening remains raw; C09 uses POST /api/v1/challenges/c09/screen.
# COMPASSIO_C09_ENABLED=false
# COMPASSIO_C11_ENABLED=false
# C11 replaces the Task 009 screening limiter. Use --no-proxy-headers.
