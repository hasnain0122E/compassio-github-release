# ---------------------------------------------------------------- data (never commit datasets)
# Only README files in each stage directory are tracked. Manifests are tracked.
data/raw/*
!data/raw/README.md
data/interim/*
!data/interim/README.md
data/processed/*
!data/processed/README.md
# ML v2 external downloads, candidate datasets, review worksheets and sealed test labels
# (licence and privacy review pending; never committed).
data/ml_v2/
# Local project database (derived from licensed sources; never committed).
data/db/*
!data/db/README.md
# Backend-only downloaded source snapshots (Task 006-DB). Metadata is tracked separately in
# data/manifests/backend_source_registry.json (no records).
data/raw_db/*
!data/raw_db/README.md
