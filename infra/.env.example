# Cloud backend; configure in provider dashboard. No canonical artifacts uploaded.
PORT=10000
COMPASSIO_ENVIRONMENT=production
COMPASSIO_SOURCE_DATA_ACCESS=public
COMPASSIO_CORS_ORIGINS=https://your-project.vercel.app
COMPASSIO_ML_V2_LOCAL_DEMO=false
COMPASSIO_PRELOAD_MODELS=false
COMPASSIO_C09_ENABLED=false
COMPASSIO_C11_ENABLED=true
COMPASSIO_MAX_REQUEST_BODY_BYTES=262144
# Vercel BUILD environment, public origin only; never a secret.
NEXT_PUBLIC_COMPASSIO_API_URL=https://your-service.onrender.com
# DORMANT: enable only after documented approval for cloud transfer.
# COMPASSIO_RUNTIME_ROOT=/tmp/compassio-runtime
# COMPASSIO_RUNTIME_DOWNLOADS_FILE=/etc/secrets/runtime-downloads.json
# COMPASSIO_RUNTIME_APPROVAL_FILE=/etc/secrets/cloud-transfer-approval.json
# COMPASSIO_DATABASE_URL=sqlite:////tmp/compassio-runtime/data/db/compassio_dev.sqlite
# COMPASSIO_INFERENCE_ROOT=/tmp/compassio-runtime
# Provisioning does not enable production inference or clear source serving rights.
